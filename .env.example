# Spotify Developer app (developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Must exactly match the redirect URI registered on the Spotify app
SPOTIFY_REDIRECT_URI=https://your-domain.example/api/spotify/callback

# Random long string used to sign session cookies
SESSION_SECRET=

# One-time seed for the parent PIN. Only used the very first time the
# server boots with an empty database - ignored on every boot after that.
# You will be forced to change it on first login. See README for details.
PARENT_INITIAL_PIN=

PORT=3000
DATA_DIR=./src/data
